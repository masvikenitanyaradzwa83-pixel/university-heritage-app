* {
  box-sizing: border-box;
}

:root {
  --bg: #f4efe7;
  --bg-deep: #e5dcc8;
  --panel: rgba(255, 255, 255, 0.8);
  --panel-solid: #fffdf9;
  --ink: #1d2a23;
  --muted: #53615a;
  --gold: #c9952d;
  --gold-soft: #f7e6b5;
  --forest: #234d3f;
  --forest-soft: #dfeee8;
  --stroke: rgba(29, 42, 35, 0.12);
  --shadow: 0 18px 50px rgba(16, 24, 20, 0.08);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(180deg, var(--bg) 0%, #f9f5ef 100%);
  color: var(--ink);
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1280px;
  margin: 0 auto;
  padding: 28px 24px 64px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 12px 8px 30px;
}

.brand-group {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  width: 54px;
  height: 54px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--forest), #3a6658);
  color: white;
  font-weight: 800;
  font-size: 1.5rem;
}

.eyebrow {
  margin: 0 0 6px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--muted);
}

.eyebrow.gold {
  color: var(--gold);
}

.topbar h1 {
  margin: 0;
  font-size: 1.2rem;
}

.nav {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

.nav a {
  text-decoration: none;
  color: var(--ink);
  font-weight: 600;
  opacity: 0.8;
}

.hero {
  display: grid;
  grid-template-columns: 1.45fr 0.9fr;
  gap: 28px;
  align-items: center;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.62));
  border: 1px solid var(--stroke);
  border-radius: 30px;
  padding: 36px;
  box-shadow: var(--shadow);
}

.hero-copy h2 {
  margin: 0 0 14px;
  font-size: clamp(2.4rem, 5vw, 4rem);
  line-height: 1.04;
  max-width: 620px;
}

.hero-copy p {
  max-width: 620px;
  color: var(--muted);
  font-size: 1.05rem;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 24px;
}

.primary-btn,
.secondary-btn,
.tag {
  border: none;
  border-radius: 999px;
  padding: 0.9rem 1.2rem;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--forest), #466d5e);
  color: white;
  box-shadow: 0 16px 32px rgba(35, 77, 63, 0.24);
}

.secondary-btn {
  background: rgba(199, 149, 45, 0.12);
  color: var(--forest);
}

.primary-btn:hover,
.secondary-btn:hover,
.tag:hover,
.heritage-card:hover,
.map-pin:hover {
  transform: translateY(-1px);
}

.search-card {
  background: var(--panel-solid);
  border: 1px solid var(--stroke);
  border-radius: 24px;
  padding: 22px;
  box-shadow: var(--shadow);
}

.search-card label {
  display: block;
  font-weight: 700;
  margin-bottom: 10px;
}

.search-card input {
  width: 100%;
  border: 1px solid var(--stroke);
  background: #f9f7f3;
  border-radius: 14px;
  padding: 14px 16px;
  font-size: 1rem;
  color: var(--ink);
  margin-bottom: 14px;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.tag {
  background: #f4efe7;
  color: var(--ink);
  padding: 0.6rem 0.8rem;
}

.tag.active {
  background: var(--forest);
  color: white;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-top: 28px;
}

.stat-card {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--stroke);
  border-radius: 20px;
  padding: 20px;
  box-shadow: var(--shadow);
}

.stat-card strong {
  display: block;
  font-size: clamp(1.8rem, 2.5vw, 2.5rem);
  margin-bottom: 8px;
}

.stat-card span {
  color: var(--muted);
}

.discover-section,
.campus-section,
.tour-section,
.timeline-section,
.stories-section {
  margin-top: 56px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 16px;
  margin-bottom: 18px;
}

.section-heading h3 {
  margin: 0;
  font-size: clamp(1.7rem, 3vw, 2.5rem);
}

.section-heading span {
  color: var(--muted);
  font-weight: 600;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.heritage-card {
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid var(--stroke);
  padding: 0;
  border-radius: 22px;
  text-align: left;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.heritage-card.selected {
  outline: 3px solid rgba(35, 77, 63, 0.25);
}

.thumbnail {
  height: 170px;
  display: flex;
  align-items: end;
  padding: 18px;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  background: linear-gradient(135deg, rgba(17, 36, 33, 0.12), rgba(17, 36, 33, 0.22));
}

.card-copy {
  padding: 18px 18px 20px;
}

.mini-tag {
  display: inline-block;
  background: rgba(35, 77, 63, 0.08);
  border-radius: 999px;
  color: var(--forest);
  font-size: 0.72rem;
  padding: 0.38rem 0.7rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  margin-bottom: 8px;
}

.card-copy h4,
.tour-card h4,
.detail-panel h3,
.timeline-item h4 {
  margin: 0 0 10px;
}

.card-copy p,
.detail-panel p,
.timeline-item p,
.story-card p,
.tour-card ol,
.detail-panel li {
  color: var(--muted);
  line-height: 1.7;
}

.map-layout {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 24px;
  align-items: stretch;
}

.map-panel,
.detail-panel,
.tour-card,
.story-card,
.timeline-item {
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid var(--stroke);
  border-radius: 22px;
  box-shadow: var(--shadow);
}

.map-panel {
  padding: 20px;
}

.map-surface {
  position: relative;
  height: 420px;
  border-radius: 22px;
  background:
    linear-gradient(135deg, rgba(35, 77, 63, 0.16), rgba(141, 190, 160, 0.24)),
    linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px),
    linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),
    #edf3ed;
  background-size: auto, 32px 32px, 32px 32px, auto;
  overflow: hidden;
}

.map-grid {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(12, 34, 25, 0.05), transparent 50%, rgba(12, 34, 25, 0.03));
}

.map-pin {
  position: absolute;
  transform: translate(-50%, -50%);
  border: none;
  border-radius: 999px;
  color: white;
  font-weight: 700;
  padding: 0.72rem 0.9rem;
  box-shadow: 0 16px 22px rgba(0, 0, 0, 0.12);
}

.map-pin span {
  display: none;
}

.map-pin.active {
  outline: 4px solid rgba(255, 255, 255, 0.7);
}

.detail-panel {
  padding: 22px;
}

.detail-meta {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 12px;
}

.detail-panel ul {
  padding-left: 20px;
  margin: 18px 0 20px;
}

.wide {
  width: 100%;
}

.tour-grid,
.story-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.tour-card,
.story-card {
  padding: 22px;
}

.tour-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin-bottom: 10px;
}

.tour-card ol {
  padding-left: 18px;
  margin: 16px 0 20px;
}

.timeline {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.timeline-item {
  padding: 22px;
}

.year {
  display: inline-block;
  background: var(--gold-soft);
  color: var(--forest);
  border-radius: 999px;
  font-weight: 800;
  padding: 0.45rem 0.75rem;
  margin-bottom: 14px;
}

.story-card {
  min-height: 170px;
}

.story-number {
  display: inline-block;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--gold);
  margin-bottom: 14px;
}

@media (max-width: 980px) {
  .hero,
  .map-layout,
  .feature-grid,
  .timeline,
  .tour-grid,
  .story-grid,
  .stats-row {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero {
    padding: 24px 18px;
  }
}

@media (max-width: 640px) {
  .app-shell {
    padding: 20px 16px 48px;
  }

  .nav {
    gap: 10px 12px;
  }

  .hero-copy h2 {
    font-size: 2.2rem;
  }

  .map-surface {
    height: 300px;
  }
}
